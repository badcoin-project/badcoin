diff --git a/qtbase/config.tests/unix/arch.test b/qtbase/config.tests/unix/arch.test
index 8d47600..39597c8 100755
--- a/qtbase/config.tests/unix/arch.test
+++ b/qtbase/config.tests/unix/arch.test
@@ -66,4 +66,14 @@
-if strings - $binary 2>/dev/null | \
-    awk -F: '/\=\=Qt\=magic\=Qt\=\= Architecture/ { print "'$VARPREFIX'_ARCH=\"" $2 "\"" }
-             /\=\=Qt\=magic\=Qt\=\= Sub-architecture/ { print "'$VARPREFIX'_CPUFEATURES=\"" $2 "\"" }' > "$RESULTFILE"
+if LC_ALL=C strings - $binary 2>/dev/null |
+while IFS= read -r line; do
+    case "$line" in
+    *"==Qt=magic=Qt== Architecture:"*)
+        value=${line#*==Qt=magic=Qt== Architecture:}
+        printf '%s_ARCH="%s"\n' "$VARPREFIX" "$value"
+        ;;
+    *"==Qt=magic=Qt== Sub-architecture:"*)
+        value=${line#*==Qt=magic=Qt== Sub-architecture:}
+        printf '%s_CPUFEATURES="%s"\n' "$VARPREFIX" "$value"
+        ;;
+    esac
+done > "$RESULTFILE"
 then
